def is_last_day_of_30_day_month():
    today = datetime.now()
    _, days_in_month = calendar.monthrange(today.year, today.month)
    return today.day == 30 and days_in_month == 30

#  Безопасный клик
def safe_click(x, y, delay=0.7):
    pyautogui.moveTo(x, y, duration=0.3)
    pyautogui.click()
    time.sleep(delay)

# Проверка, запущен ли BlueStacks
def is_bluestacks_running():
    return any('HD-Player.exe' in p.name() for p in psutil.process_iter())

# Автоперезапуск скрипта
def restart_script():
    try:
        bot.send_message(chat_id=TELEGRAM_CHAT_ID, text=" Перезапуск скрипта из-за ошибки...")
    except:
        pass
    python = sys.executable
    os.execl(python, python, *sys.argv)

